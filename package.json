{
  "name": "@ntutbox/map",
  "version": "0.9.0",
  "description": "北科盒子（NTUT Box）校園與室內地圖：2.5D 樓層圖、空教室著色、校園白模，讀取公開的校園資料 CDN",
  "license": "MIT",
  "author": "PoterPan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poterpan/ntutbox-map.git"
  },
  "homepage": "https://github.com/poterpan/ntutbox-map#readme",
  "bugs": "https://github.com/poterpan/ntutbox-map/issues",
  "keywords": ["ntut", "campus-map", "indoor-map", "threejs"],
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./style.css": "./src/engine/indoor-map.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": ["*.css"],
  "files": [
    "src",
    "docs/DATA-FORMAT.md",
    "docs/DESIGN.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <1.0.0"
  },
  "devDependencies": {
    "three": "^0.180.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
